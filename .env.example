APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=info
APP_DATA_DIR=./data
APP_API_MAX_REQUEST_BYTES=1048576
# Explicitly choose demo (synthetic, no model calls) or a real agent factory.
APP_STAGE_FACTORY=
APP_WORKER_POLL_SECONDS=0.5
BACKEND_PORT=8000
APP_MODEL_PROVIDER=codex
# Empty: default Codex model. OpenRouter requires an explicit model ID.
APP_MODEL_NAME=
APP_MODEL_API_KEY=
APP_MODEL_TIMEOUT_SECONDS=60
APP_MODEL_MAX_TOKENS=2048
APP_MODEL_MAX_RETRIES=1
# Optional estimate reserved BEFORE EACH model attempt when Limits.budget is set.
# Uses APP_MODEL_COST_CURRENCY. This does not cap the provider's actual charge.
APP_MODEL_CALL_COST_RESERVE=
APP_CODEX_COMMAND=codex
# Optional manual tariff for cost estimates, per 1 million tokens.
# Requires an explicit APP_MODEL_NAME and both rates; never invent prices.
APP_MODEL_INPUT_COST_PER_MILLION=
APP_MODEL_OUTPUT_COST_PER_MILLION=
APP_MODEL_COST_CURRENCY=USD
APP_MODEL_PRICING_VERSION=
